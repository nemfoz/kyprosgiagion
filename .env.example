# Local development: copy to .env.local (only the auth values are needed; data/app.db is used automatically).
# Production values: copy to .env.production.local for the sync/import scripts and `npm run dev:prod`.
# Get them from Vercel (Storage → Turso / Blob → .env.local tab) or: npx vercel env pull .env.production.local --environment=production

# Auth
BETTER_AUTH_SECRET=            # long random string: openssl rand -hex 32 (falls back to SESSION_SECRET)
SUPERADMIN_EMAILS=             # comma-separated; these accounts become superadmins when they sign up
# BETTER_AUTH_URL=https://kyprosgiagion.vercel.app   # optional; set when using a custom domain

# Database (Turso) — leave empty locally to use data/app.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Photo storage (Vercel Blob) — leave empty locally to use ./uploads
BLOB_READ_WRITE_TOKEN=
