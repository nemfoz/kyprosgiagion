# Local development: copy to .env.local (only the auth values are needed; data/app.db is used automatically).
# On the server the same variables go in .env next to docker-compose.yml (README "Self-hosting").

# Auth
BETTER_AUTH_SECRET=            # long random string: openssl rand -hex 32 (falls back to SESSION_SECRET)
SUPERADMIN_EMAILS=             # comma-separated; these accounts become superadmins when they sign up
# BETTER_AUTH_URL=https://odoiporiko.com   # the server's public address

# E-mail (Resend) — confirmation and password-reset e-mails. Locally, leave empty to print them in the console.
RESEND_API_KEY=
EMAIL_FROM="Οδοιπορικό <noreply@odoiporiko.com>"   # the domain must be verified in Resend

# Cloudflare Turnstile (anti-spam CAPTCHA) — leave both empty to disable (e.g. locally).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
