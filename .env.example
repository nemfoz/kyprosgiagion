# Copy to .env.production.local (never commit it) and fill in the values from Vercel:
#   Storage → your Turso database → .env.local tab, and Storage → your Blob store → .env.local tab
# or run:  npx vercel env pull .env.production.local --environment=production
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=
ADMIN_PASSWORD=
SESSION_SECRET=
