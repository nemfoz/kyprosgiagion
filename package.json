{
  "name": "kyprosagiongi",
  "version": "0.2.0",
  "private": true,
  "description": "Map of the churches and monasteries of Cyprus, starting with the Karpasia peninsula and Famagusta District",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "migrate": "node scripts/migrate.mjs",
    "dev:prod": "node --env-file=.env.production.local scripts/migrate.mjs && dotenv -e .env.production.local -- next dev",
    "sync:pull": "node --env-file=.env.production.local scripts/sync.mjs pull",
    "sync:push": "node --env-file=.env.production.local scripts/sync.mjs push",
    "rehost-photos": "node scripts/rehost-photos.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@vercel/blob": "2.8.2",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "5.24.0",
    "next": "16.3.8",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "shadcn": "^4.22.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
