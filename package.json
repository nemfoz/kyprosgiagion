{
  "name": "kyprosagiongi",
  "version": "0.1.0",
  "private": true,
  "description": "Map of the churches and monasteries of Cyprus, starting with the Karpasia peninsula and Famagusta District",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "reset-db": "rm -f data/app.db* && node -e \"import('./lib/db.js')\"",
    "dev:prod": "node --env-file=.env.production.local --watch server.js",
    "sync:pull": "node --env-file=.env.production.local scripts/sync.mjs pull",
    "sync:push": "node --env-file=.env.production.local scripts/sync.mjs push"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@vercel/blob": "^2.8.2",
    "express": "^4.21.2"
  }
}
